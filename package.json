{
  "name": "beatempie-phaser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BeatEmPie — a 2D web arcade beat 'em up where Shushki fights waves of fish and whales by dropping magical pies from the sky.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "graph:build": "node scripts/graphify.mjs build",
    "graph:update": "node scripts/graphify.mjs update",
    "graph:cluster": "node scripts/graphify.mjs cluster",
    "graph:query": "node scripts/graphify.mjs query",
    "graph:path": "node scripts/graphify.mjs path",
    "graph:explain": "node scripts/graphify.mjs explain",
    "graph:status": "node scripts/graphify.mjs status",
    "graph:check": "node scripts/graphify.mjs check",
    "graph:watch": "node scripts/graphify.mjs watch"
  },
  "keywords": [
    "phaser",
    "game",
    "arcade",
    "beat-em-up",
    "typescript",
    "vite"
  ],
  "author": "Dotan, Romi, Noam",
  "license": "MIT",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
