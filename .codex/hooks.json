{
  "description": "Provide lightweight Graphify context when a local graph exists.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/graphify-session-start.cjs\"",
            "commandWindows": "node -e \"const cp=require('node:child_process'),p=require('node:path');const r=cp.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();require(p.join(r,'scripts','graphify-session-start.cjs'));\"",
            "timeout": 3,
            "additionalContextLimit": 300
          }
        ]
      }
    ]
  }
}
